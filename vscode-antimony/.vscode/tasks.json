// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			// The extension's "main" is ./dist/extension.js, produced by webpack.
			// The old default build task ran `tsc -watch`, which writes to out/
			// and is never loaded -- so F5 silently ran a stale dist/ bundle.
			//
			// problemMatcher is "$tsc" rather than "$ts-webpack": the latter needs
			// the eamodio.tsl-problem-matcher extension, and an unknown matcher
			// makes VS Code flag the task and refuse to run it.
			"type": "npm",
			"script": "webpack",
			"problemMatcher": "$tsc",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "silent"
			}
		}
	]
}